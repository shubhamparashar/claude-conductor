{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/model-routing-context.mjs",
                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/claude-md-size-check.mjs",
                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/conductor-doctor.mjs ${CLAUDE_PLUGIN_ROOT}",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/metrics-share-nudge.mjs",
                        "timeout": 5
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/memory-nudge.mjs",
                        "timeout": 5
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/delegation-journal.mjs",
                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-cleanup.mjs",
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/post-task-reflect.mjs",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/goal-contract-gate.mjs",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/context-pressure-warn.js",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
